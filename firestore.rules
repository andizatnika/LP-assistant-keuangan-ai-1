rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidTelegramMessage(data) {
      return data.keys().hasAll(['chatId', 'type', 'amount', 'category', 'timestamp'])
        && data.chatId is string
        && data.type is string
        && data.amount is number
        && data.category is string
        && data.timestamp is number;
    }

    // ✅ Users collection — checkout menulis ke sini
    match /users/{userId} {
      allow read, write: if true;
    }

    // Telegram
    match /telegram_config/{chatId} {
      allow read, write: if true;
    }

    match /telegram_inbox/{chatId}/messages/{msgId} {
      allow create: if true;
      allow read: if true;
      allow delete: if true;
    }

    // Catch-all: blokir semua yang tidak disebutkan
    match /{document=**} {
      allow read, write: if false;
    }
  }
}