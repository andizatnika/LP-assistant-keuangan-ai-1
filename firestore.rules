rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Strict schema validation for User Profile
    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.whatsapp is string && data.whatsapp.size() <= 20
        && data.role == 'user'
        && data.isVerified is bool
        && data.createdAt is timestamp
        // expiresAt is optional initially, set during verification
        && (!data.keys().hasAll(['expiresAt']) || data.expiresAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      
      allow create: if isSignedIn() 
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().isVerified == false;

      // Allow users to update their profile to verify it
      allow update: if (
        isSignedIn() && isOwner(userId) && (
          // Action: Verify Account
          (incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'expiresAt']))
        )
      );
    }
  }
}
