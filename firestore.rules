rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'andyzatnika92@gmail.com'; }

    match /users/{userId} {
      // User can read their own or Create their own
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      
      // Admin can do everything
      allow list, update, delete: if isAdmin();
      
      // Extra: allow users to check their own status during login
      allow read: if isOwner(userId);
    }
    
    // Existing collections support
    match /telegram_config/{chatId} {
      allow read, write: if isAdmin();
    }
    match /telegram_inbox/{chatId}/messages/{msgId} {
      allow read, write: if isAdmin();
    }
  }
}
